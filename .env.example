# NextStep OS — Environment Variables Template
# Copy this file to .env and populate with your credentials
# DO NOT commit real secrets or production keys to version control

# Runtime Environment (development | production | test)
NODE_ENV=production

# Server Port (default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Google Gemini API Key for AI Saarthi & Interview Prep
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# JSON Web Token Secret Key for user authentication sessions
JWT_SECRET=

# Client Application URL (used for CORS and redirect resolution)
# Example: https://nextstep.vercel.app or http://localhost:5000
CLIENT_URL=
